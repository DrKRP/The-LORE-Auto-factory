  "entry": "why",
  "nodes": {
    "why": {
      "role": "probe",
      "objectives": [
        "O2"
      ],
      "ask_confidence": true,
      "say": [
        {
          "text": "A fire victim has a headache and is confused. The pulse oximeter reads 98%, and the chest film is clear.",
          "claims": [
            "K30"
          ]
        },
        {
          "text": "Why can that normal reading still mislead you?",
          "claims": []
        }
      ],
      "choices": [
        {
          "label": "A normal saturation means oxygen content is normal",
          "next": "why_t13",
          "kind": "trap",
          "trap": "TR13"
        },
        {
          "label": "It cannot tell carboxyhaemoglobin from oxyhaemoglobin",
          "next": "why_ok",
          "kind": "correct"
        },
        {
          "label": "Not sure, give me a hint",
          "next": "why_hint",
          "kind": "help"
        }
      ]
    },
    "why_hint": {
      "role": "hint",
      "objectives": [
        "O2"
      ],
      "say": [
        {
          "text": "Ask what the probe actually measures: light absorbed at two wavelengths, and which haemoglobin forms that light can tell apart.",
          "claims": [
            "K30"
          ]
        }
      ],
      "choices": [
        {
          "label": "Back to the question",
          "next": "why",
          "kind": "retry"
        }
      ]
    },
    "why_t13": {
      "role": "feedback",
      "objectives": [
        "O2"
      ],
      "say": [
        {
          "text": "The tempting model: a number on the screen feels like proof of the oxygen in the blood. The probe reads only two light wavelengths, so a normal number says little in smoke.",
          "claims": [
            "K86"
          ]
        },
        {
          "text": "Not this one. Carboxyhaemoglobin can be high while the reading looks normal, so only a blood level answers the question.",
          "claims": [
            "K30",
            "K33"
          ]
        }
      ],
      "sure_note": {
        "text": "You were sure, so this is the trap to fear most: a normal saturation does not exclude carbon monoxide.",
        "claims": [
          "K86"
        ]
      },
      "choices": [
        {
          "label": "Try again",
          "next": "why",
          "kind": "retry"
        }
      ]
    },
    "why_ok": {
      "role": "feedback",
      "objectives": [
        "O2"
      ],
      "say": [
        {
          "text": "Yes. The probe cannot separate carboxyhaemoglobin from oxyhaemoglobin, so a normal reading never excludes carbon monoxide.",
          "claims": [
            "K30",
            "K86"
          ]
        },
        {
          "text": "Send a carboxyhaemoglobin level by co-oximetry instead.",
          "claims": [
            "K33"
          ]
        }
      ],
      "choices": [
        {
          "label": "Next",
          "next": "caseA_1",
          "kind": "continue"
        },
        {
          "label": "I know this ladder, skip the worked case",
          "next": "fadeB",
          "kind": "skip"
        }
      ]
    },
