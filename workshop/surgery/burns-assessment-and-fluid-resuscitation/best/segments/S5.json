        }
      ],
      "choices": [
        {
          "label": "The burn damages the heart, so it needs volume to restore output",
          "next": "why_t31a",
          "kind": "trap",
          "trap": "TR31"
        },
        {
          "label": "Capillary leak drains plasma out of the circulation for hours",
          "next": "why_ok",
          "kind": "correct"
        },
        {
          "label": "The wound is infected, and sepsis needs large volume to clear it",
          "next": "why_t31b",
          "kind": "trap",
          "trap": "TR31"
        },
        {
          "label": "Not sure, give me a hint",
          "next": "why_hint",
          "kind": "help"
        }
      ]
    },
    "why_hint": {
      "role": "hint",
      "say": [
        {
          "text": "Ask what the burn does to the blood vessels first, before any pump problem or infection.",
          "claims": []
        }
      ],
      "choices": [
        {
          "label": "Try again",
          "next": "why",
          "kind": "retry"
        }
