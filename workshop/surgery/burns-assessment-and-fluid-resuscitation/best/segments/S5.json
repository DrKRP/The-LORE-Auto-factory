    "why_ok": {
      "role": "feedback",
      "say": [
        {
          "text": "Yes. Mediators released by the burn raise capillary permeability, so plasma leaks out. The leak is maximal in the first 8 to 12 hours and continues up to 24 hours.",
          "claims": [
            "K17"
          ]
        },
        {
          "text": "That makes burn shock mainly hypovolaemic, and Ringer lactate is the fluid of choice.",
          "claims": [
            "K19",
            "K68"
          ]
        }
      ],
      "choices": [
        {
          "label": "Next",
          "next": "t1_try",
          "kind": "continue"
        }
      ]
    },
    "why_t31a": {
      "role": "feedback",
      "say": [
        {
          "text": "That is not right. A fast pulse and low pressure make the heart look like the culprit, but myocardial depression is only an added factor in burn shock.",
          "claims": [
            "K19"
          ]
        }
      ],
      "sure_note": {
        "text": "You were sure, so name the main cause before the added factor. Ask what the volume is replacing.",
        "claims": [
          "K19"
        ]
      },
      "choices": [
        {
          "label": "Try again",
          "next": "why",
          "kind": "retry"
        }
