    "contrast_ok": {
      "role": "feedback",
      "objectives": [
        "O5"
      ],
      "say": [
        {
          "text": "Yes. Full thickness is painless, dry, leathery and does not blanch. Deep partial is less painful, with mottling and slow refill.",
          "claims": [
            "K26",
            "K25"
          ]
        }
      ],
      "choices": [
        {
          "label": "Next",
