      "role": "feedback",
      "objectives": [
        "O5"
      ],
      "say": [
        {
          "text": "That is not right. Deep partial burns also hurt less than normal skin, so reduced pain does not separate the two.",
          "claims": [
            "K25"
          ]
        },
        {
          "text": "Pain is the first thing you check at the bedside, so it feels like the separator. Ask whether sensation is gone, not whether it hurts less.",
          "claims": [
            "K26"
          ]
        }
      ],
      "choices": [
