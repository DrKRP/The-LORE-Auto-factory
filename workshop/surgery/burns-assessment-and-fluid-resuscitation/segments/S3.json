    "contrast_t_heal": {
      "role": "feedback",
      "objectives": [
        "O5"
      ],
      "say": [
        {
          "text": "That is not right. Slow healing with scarring describes deep partial burns, so it cannot separate the two.",
          "claims": [
            "K25"
          ]
        },
        {
          "text": "Duration is a favourite exam clue, but on the day you judge sensation, blanching and dryness. Depth often declares itself only at 48 to 72 hours.",
          "claims": [
            "K26",
            "K28"
          ]
        }
      ],
      "choices": [
        {
          "label": "Try again",
          "next": "depth_contrast",
          "kind": "retry"
