  "nodes": {
    "wx_case": {
      "role": "case",
      "objectives": [
        "O5",
        "O6"
      ],
      "say": [
        {
          "text": "Worked case first. A 48-year-old woman has a 3 cm firm lump, mobile nodes in the armpit, normal skin and no fixity.",
          "claims": []
        },
        {
          "text": "Step one, size: 3 cm is over 2 cm and up to 5 cm, so the tumour is **T2**.",
          "claims": [
            "K62"
          ]
        },
        {
          "text": "Step two, skin and chest wall: no skin change and nothing fixed to the chest wall, so no T4 label applies. Mobile level I and II nodes are **N1**.",
          "claims": [
            "K64",
            "K65",
            "K68"
          ]
        }
      ],
      "choices": [
        {
          "label": "Next",
          "next": "wx_scan",
          "kind": "continue"
        },
        {
          "label": "I know T and N, skip the walk-through",
          "next": "fade1",
          "kind": "skip"
        }
      ]
    },
    "wx_scan": {
      "role": "explain",
      "objectives": [
        "O4"
      ],
      "say": [
        {
          "text": "Step three, the metastatic work-up. Locally advanced (stage III) disease means a tumour over 5 cm with nodes, a T4 tumour, or N2 or N3 nodes.",
          "claims": [
            "K75"
          ]
        },
        {
          "text": "This patient has none of those and no symptoms, so a bone scan, CT or PET is not routine. Imaging is for locally advanced disease or symptoms.",
          "claims": [
            "K57"
          ]
        }
      ],
      "choices": [
        {
          "label": "Next",
          "next": "fade1",
          "kind": "continue"
        }
      ]
    },
    "fade1": {
      "role": "probe",
      "objectives": [
        "O5"
      ],
      "ask_confidence": true,
      "say": [
        {
          "text": "Case B, same method. The skin step is yours this time.",
